#!/bin/sh
set -eu
work=$(mktemp -d)
trap 'rm -rf "$work"' EXIT
trap 'exit 1' HUP INT TERM
awk 'payload {print} /^__FCXRAY_ARCHIVE__$/ {payload=1}' "$0" | base64 -d > "$work/source.tgz"
tar -xzf "$work/source.tgz" -C "$work"
sh "$work/install.sh" "$@"
exit $?
